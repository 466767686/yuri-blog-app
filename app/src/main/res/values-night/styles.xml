<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="colorPrimary">@color/brand</item>
    <item name="colorAccent">@color/brand</item>
    <item name="android:windowBackground">@color/surface</item>
    <!-- 暗色下状态栏图标要转成浅色，否则看不见 -->
    <item name="android:statusBarColor">@color/surface</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:navigationBarColor">@color/surface</item>
    <item name="android:windowLightNavigationBar">false</item>
  </style>

  <style name="SplashTheme" parent="AppTheme">
    <item name="android:windowBackground">@drawable/splash_gradient</item>
  </style>
</resources>
